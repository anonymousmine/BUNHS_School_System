# BUNHS School System - Git Ignore File

# Environment files
.env
.env.local
.env.production
.env.development

# Cache and temporary files
cache/
logs/
*.log
*.tmp
*.temp

# Uploads and user-generated content
uploads/
pics/

# Vendor dependencies (will be installed via composer)
vendor/
composer.phar

# Node modules (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Backup files
*.bak
*.backup
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Empty directories (keep structure but ignore contents)
!cache/.gitkeep
!logs/.gitkeep
!uploads/.gitkeep
!pics/.gitkeep

# Database backups and exports
*.sql
!database_setup_fixed.sql

# Session files
sess_*

# PHP specific
*.cache
.php_cs.cache
.phpunit.result.cache

# Apache/Nginx logs
access.log
error.log

# Railway specific
.railway/
